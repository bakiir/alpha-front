# Local: leave unset to use same-origin `/api` via Nuxt devProxy (HttpOnly cookies work).

# NUXT_PUBLIC_API_BASE=/api



# Staging / production — required on the Nuxt host (PM2 / .env)

# Must match CORS_ALLOWED_ORIGINS / ALPHA_FRONTEND_URL on the API for cookie auth.

NUXT_PUBLIC_API_BASE=https://back-alpha.test-nomad.kz/api



# Demo / maintenance only: show hardcoded tariffs when API is empty or down.

# Leave unset/false in production so API failures are visible to users.

# NUXT_PUBLIC_DEMO_SUBSCRIPTION_PLANS=true

